# AgroManager Environment Configuration
# Copy this to .env and update values for your environment

# Django Security Settings
# Generate a new SECRET_KEY with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secure-secret-key-here-change-in-production

# Debug mode - MUST be False in production
DEBUG=False

# Allowed hosts for the application (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com,www.yourdomain.com

# Database Configuration (optional - for future PostgreSQL migration)
# DATABASE_URL=postgresql://user:password@localhost:5432/agromanager

# Email Configuration (optional)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-email-password
